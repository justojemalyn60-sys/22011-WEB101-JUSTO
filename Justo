<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Static Profile — Member Portal</title>
  <style>
    :root{
      --bg:#f6f7fb; --card:#ffffff; --accent:#4f46e5; --muted:#6b7280;
      --glass: rgba(255,255,255,0.6);
    }
    *{box-sizing:border-box}
    body{font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; margin:0; background:linear-gradient(180deg,var(--bg),#eef2ff); color:#111}
    header{background:var(--card); backdrop-filter: blur(6px); box-shadow:0 2px 8px rgba(15,23,42,0.06); position:sticky; top:0; z-index:10}
    .container{max-width:1000px;margin:0 auto;padding:20px}
    nav{display:flex;gap:16px;align-items:center;justify-content:space-between}
    .brand{display:flex;gap:12px;align-items:center}
    .logo{width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#06b6d4);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}
    .nav-links a{margin-left:14px;text-decoration:none;color:var(--muted);font-weight:600}
    .nav-links a.active{color:var(--accent)}
    main{padding:28px 0}
    .grid{display:grid;grid-template-columns:320px 1fr;gap:24px}
    /* profile card */
    .card{background:var(--card);border-radius:14px;padding:18px;box-shadow:0 6px 30px rgba(15,23,42,0.06)}
    .avatar{width:88px;height:88px;border-radius:14px;background:linear-gradient(180deg,#eef2ff,#e9d5ff);display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:700;color:var(--accent)}
    h1{margin:8px 0 0;font-size:20px}
    p.lead{color:var(--muted);margin:6px 0 12px}
    .meta{display:flex;gap:12px;color:var(--muted);font-size:14px}
    .btn{display:inline-block;padding:8px 12px;border-radius:10px;text-decoration:none;font-weight:700}
    .btn-primary{background:var(--accent);color:white}
    .btn-ghost{background:transparent;border:1px solid #eef2ff;color:var(--accent)}

    /* members list */
    .members{display:flex;flex-direction:column;gap:10px}
    .member{display:flex;gap:12px;align-items:center;padding:10px;border-radius:10px;background:linear-gradient(180deg,var(--glass),transparent)}
    .member-info{flex:1}
    .member-name{font-weight:700}
    .member-role{font-size:13px;color:var(--muted)}

    /* about */
    .about{line-height:1.6;color:#111}

    footer{margin-top:22px;color:var(--muted);font-size:13px;text-align:center}

    @media (max-width:880px){
      .grid{grid-template-columns:1fr;}
      .nav-links a{margin-left:8px}
      .logo{width:40px;height:40px}
    }
  </style>
</head>
